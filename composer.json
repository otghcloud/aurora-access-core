{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "otghcloud/aurora-access-core",
    "type": "library",
    "description": "Laravel package providing Aurora Access Control core domain, admin UI, routes, and runtime services.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.8",
        "laravel/pail": "^1.2",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "livewire/livewire": "^3.0",
        "php-mqtt/laravel-client": "^1.8",
        "yajra/laravel-datatables": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "OTGH\\AccessControl\\Core\\": "src/"
        },
        "files": [
            "src/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OTGH\\AccessControl\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": [
            "vendor/bin/pest"
        ]
    },
    "repositories": [],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "replace": {},
    "extra": {
        "laravel": {
            "providers": [
                "OTGH\\AccessControl\\Core\\Providers\\AccessCoreServiceProvider"
            ]
        }
    }
}
